[Unit]
Description=PI3TWE SvxLink met bewaakte BASE/PTT-brug
After=network-online.target sound.target pi3twe-audio-init.service
Wants=network-online.target
Requires=pi3twe-audio-init.service
Conflicts=svxlink.service

[Service]
Type=simple
User=svxlink
Group=audio
SupplementaryGroups=plugdev dialout
ExecCondition=/usr/local/sbin/pi3twe-svxlink-mode-check
ExecStartPre=+/usr/local/sbin/pi3twe-svxlink-audio-init
ExecStartPre=+/usr/local/sbin/pi3twe-svxlink-check
ExecStart=/usr/local/sbin/pi3twe-svxlink-ptt
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=pi3twe-svxlink
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
LogsDirectory=pi3twe-svxlink
LogsDirectoryMode=0750
ReadOnlyPaths=/etc/pi3twe/svxlink
ReadWritePaths=/run/pi3twe-transmitter /var/lib/pi3twe-svxdash/svxlink-news

[Install]
WantedBy=multi-user.target
